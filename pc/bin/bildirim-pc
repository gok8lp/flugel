#!/bin/bash
# PC yedek bildirim: Telegram (sunucu kapaliyken) + masaustu bildirimi. (sistem-bakim)
SEV=BILGI; [ "$1" = "--seviye" ] && { SEV=$2; shift 2; }
MSG="$*"; [ -z "$MSG" ] && exit 0
. ~/.config/sistem-bakim/telegram.env 2>/dev/null
[ -n "$TELEGRAM_BOT_TOKEN" ] && curl -s -m 15 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=[flugelubuntu] $SEV: $MSG" >/dev/null
notify-send -a "flugel-bot" -i dialog-information "$SEV" "$MSG" 2>/dev/null || true
echo "$(date '+%F %T')|$SEV|$(echo "$MSG" | tr '\n' ' ')" >> ~/.local/share/flugel-bot/bildirimler.log
